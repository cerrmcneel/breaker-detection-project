      <column caption='Visual Simultaneity' datatype='real' name='[Calculation_4688088694407169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [iga_amp] = 0 THEN 5 &#13;&#10;ELSEIF ISNULL([simultaneity_ratio]) THEN 5&#13;&#10;ELSE [simultaneity_ratio] &#13;&#10;END' />
